// Prisma schema — datasource and generator are pre-wired.
// Your DATABASE_URL lives in server/.env (copy it from .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Lab 1 Issue 3 — IT request categories
// ---------------------------------------------------------------------------

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  tickets Ticket[]
}

// ---------------------------------------------------------------------------
// Lab 2 Issue 2 — Full schema for Requester, Ticket, Attachment, RelatedSystem
// ---------------------------------------------------------------------------

// Enum for Requested Priority (set by Requester on ticket creation)
enum Priority {
  LOW
  MEDIUM
  HIGH
}

// Enum for Current Status (NEW in Lab 2; extended in Lab 3)
enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

// Enum for User Role (Lab 3)
enum UserRole {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}

// Lab 3: Real User model with authentication and roles.
// Migrated from Lab 2's RequesterUser — existing data preserved.
// passwordHash stores bcrypt hash (never plaintext).
// requiresPasswordChange forces password change on first login or after admin reset.
model User {
  id                    Int      @id @default(autoincrement())
  name                  String
  email                 String   @unique
  passwordHash          String                    // bcrypt hash, never returned to client
  role                  UserRole                  // exactly one role per user
  isActive              Boolean  @default(true)   // inactive users cannot login
  requiresPasswordChange Boolean @default(true)   // true = must change password before normal app access
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  ticketsCreated        Ticket[]        @relation("TicketRequester")
  ticketsOwned          Ticket[]        @relation("TicketOwner")
  publicComments        PublicComment[]
  internalNotes         InternalNote[]
  actionsTaken          ActionTaken[]   // Lab 4: actions performed by this user

  @@index([email])
  @@index([isActive])
  @@index([role])
}

// Related System — the service, device, or application affected by the ticket.
// Modelled as a table (not an enum) so the list can grow without a migration.
model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]

  @@index([isActive])
}

// Ticket — core entity created by a Requester (Lab 2), extended in Lab 3 & Lab 4.
// ticketNumber is unique, backend-generated in format TKT-YYYY-NNNNNN.
// Lab 3 adds: ownerId (IT Staff/Admin owner), itPriority, problemResolvedByRequester.
// Lab 4 adds: resolvedAt (timestamp when status changed to RESOLVED), actionsTaken relation.
model Ticket {
  id                         Int          @id @default(autoincrement())
  ticketNumber               String       @unique
  requesterId                Int          // User who created the ticket (Requester)
  ownerId                    Int?         // IT Staff or Administrator who owns this ticket (nullable = unassigned)
  categoryId                 Int
  relatedSystemId            Int
  summary                    String       @db.VarChar(150)
  description                String       @db.Text
  requestedPriority          Priority     // Set by Requester, never changes
  itPriority                 Priority     @default(MEDIUM) // Initially copies requestedPriority, editable by IT Staff
  status                     TicketStatus @default(NEW)
  problemResolvedByRequester Boolean      @default(false) // Requester indicator; does NOT change status
  resolvedAt                 DateTime?    // Lab 4: timestamp when ticket was resolved (nullable = not yet resolved)
  ticketDate                 DateTime     @default(now())
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  // Relations
  requester        User            @relation("TicketRequester", fields: [requesterId], references: [id])
  owner            User?           @relation("TicketOwner", fields: [ownerId], references: [id])
  category         Category        @relation(fields: [categoryId], references: [id])
  relatedSystem    RelatedSystem   @relation(fields: [relatedSystemId], references: [id])
  attachments      Attachment[]
  publicComments   PublicComment[]
  internalNotes    InternalNote[]
  actionsTaken     ActionTaken[]   // Lab 4: actions performed on this ticket

  // Indexes on fields used for filtering, sorting, and ownership queries
  @@index([requesterId])           // requester ownership
  @@index([ownerId])               // IT Staff ownership
  @@index([categoryId])            // category filter
  @@index([requestedPriority])     // requested priority filter
  @@index([itPriority])            // IT priority filter and sort
  @@index([status])                // status filter
  @@index([createdAt])             // default sort field
  @@index([updatedAt])             // secondary sort field
  @@index([resolvedAt])            // Lab 4: dashboard queries for resolution time
}

// Lab 3: Public Comment — visible to Requester, IT Staff, and Administrator.
model PublicComment {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  content   String   @db.Text
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId])
  @@index([createdAt])
}

// Lab 3: Internal Note — visible only to IT Staff and Administrator.
model InternalNote {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  content   String   @db.Text
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId])
  @@index([createdAt])
}

// Attachment — file metadata stored per Ticket.
// Soft removal: removedAt (nullable DateTime) is set on removal together with
// removalReason. A null removedAt means the attachment is active.
// Decision: nullable DateTime is used (not a boolean isRemoved) so that the
// exact removal timestamp is always recorded for audit purposes, with no extra
// column needed.
// storedPath is the server-generated storage path and is NEVER returned to clients.
model Attachment {
  id            Int       @id @default(autoincrement())
  ticketId      Int
  originalName  String                    // original filename from the user
  storedPath    String                    // server-generated unique storage path
  mimeType      String
  sizeBytes     Int
  uploadedAt    DateTime  @default(now())
  removedAt     DateTime?                 // null = active; set = soft-removed
  removalReason String?                   // required when removedAt is set

  ticket Ticket @relation(fields: [ticketId], references: [id])

  @@index([ticketId])               // attachment list per ticket
  @@index([removedAt])              // filter active vs removed attachments
}

// Session table for express-session with connect-pg-simple (added automatically by the session store)
model session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
}

// ---------------------------------------------------------------------------
// Lab 4 — ActionTaken model for ticket workflow tracking
// ---------------------------------------------------------------------------

// ActionTaken — records actions performed by IT Staff on tickets.
// Each action documents what was done, the result, and whether follow-up is needed.
// Design Decision 1: actionDateTime is separate from createdAt because the action
// may be recorded after it was actually performed (e.g., documenting past work).
// actionDateTime = when action happened; createdAt = when record was created.
// Design Decision 2: followupNote is nullable and conditionally required (via
// business logic) only when followUpRequired=true. This keeps the schema flexible
// while enforcing the constraint at the application layer (BR-39).
// Design Decision 3: performerId links to User (not a separate actor table) because
// all IT Staff are already Users. This maintains referential integrity and audit trail.
// Design Decision 4: CASCADE delete on ticketId means if a ticket is deleted, all
// its actions are also deleted (maintaining data consistency). ON DELETE RESTRICT
// on performerId prevents accidental user deletion if they have recorded actions.
model ActionTaken {
  id                Int      @id @default(autoincrement())
  ticketId          Int                      // FK to Ticket
  performerId       Int                      // FK to User (IT Staff who performed action)
  actionDateTime    DateTime @default(now()) // When action was performed
  actionDescription String   @db.Text        // What was done
  result            String   @db.Text        // Outcome of the action
  followUpRequired  Boolean  @default(false) // Does this need follow-up?
  followupNote      String?  @db.Text        // Required when followUpRequired=true (enforced by BR-39)
  attachmentNotes   String?  @db.Text        // Optional notes about related attachments
  createdAt         DateTime @default(now()) // When this record was created
  updatedAt         DateTime @updatedAt      // Last update timestamp

  // Relations
  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  performer User   @relation(fields: [performerId], references: [id], onDelete: Restrict)

  // Indexes for efficient queries (FR-37)
  @@index([ticketId])          // Query all actions for a ticket
  @@index([performerId])       // Query all actions by a user
  @@index([actionDateTime])    // Sort by action time
  @@index([followUpRequired])  // Filter actions needing follow-up
}
