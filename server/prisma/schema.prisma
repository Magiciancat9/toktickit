// Prisma schema — datasource and generator are pre-wired.
// Your DATABASE_URL lives in server/.env (copy it from .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Lab 1 Issue 3 — IT request categories
// ---------------------------------------------------------------------------

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  tickets Ticket[]
}

// ---------------------------------------------------------------------------
// Lab 2 Issue 2 — Full schema for Requester, Ticket, Attachment, RelatedSystem
// ---------------------------------------------------------------------------

// Enum for Requested Priority (set by Requester on ticket creation)
enum Priority {
  LOW
  MEDIUM
  HIGH
}

// Enum for Current Status (NEW in Lab 2; extended in Lab 3)
enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

// Enum for User Role (Lab 3)
enum UserRole {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}

// Lab 3: Real User model with authentication and roles.
// Migrated from Lab 2's RequesterUser — existing data preserved.
// passwordHash stores bcrypt hash (never plaintext).
// requiresPasswordChange forces password change on first login or after admin reset.
model User {
  id                    Int      @id @default(autoincrement())
  name                  String
  email                 String   @unique
  passwordHash          String                    // bcrypt hash, never returned to client
  role                  UserRole                  // exactly one role per user
  isActive              Boolean  @default(true)   // inactive users cannot login
  requiresPasswordChange Boolean @default(true)   // true = must change password before normal app access
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  ticketsCreated        Ticket[]        @relation("TicketRequester")
  ticketsOwned          Ticket[]        @relation("TicketOwner")
  publicComments        PublicComment[]
  internalNotes         InternalNote[]

  @@index([email])
  @@index([isActive])
  @@index([role])
}

// Related System — the service, device, or application affected by the ticket.
// Modelled as a table (not an enum) so the list can grow without a migration.
model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]

  @@index([isActive])
}

// Ticket — core entity created by a Requester (Lab 2), extended in Lab 3.
// ticketNumber is unique, backend-generated in format TKT-YYYY-NNNNNN.
// Lab 3 adds: ownerId (IT Staff/Admin owner), itPriority, problemResolvedByRequester.
model Ticket {
  id                         Int          @id @default(autoincrement())
  ticketNumber               String       @unique
  requesterId                Int          // User who created the ticket (Requester)
  ownerId                    Int?         // IT Staff or Administrator who owns this ticket (nullable = unassigned)
  categoryId                 Int
  relatedSystemId            Int
  summary                    String       @db.VarChar(150)
  description                String       @db.Text
  requestedPriority          Priority     // Set by Requester, never changes
  itPriority                 Priority     @default(MEDIUM) // Initially copies requestedPriority, editable by IT Staff
  status                     TicketStatus @default(NEW)
  problemResolvedByRequester Boolean      @default(false) // Requester indicator; does NOT change status
  ticketDate                 DateTime     @default(now())
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  // Relations
  requester        User            @relation("TicketRequester", fields: [requesterId], references: [id])
  owner            User?           @relation("TicketOwner", fields: [ownerId], references: [id])
  category         Category        @relation(fields: [categoryId], references: [id])
  relatedSystem    RelatedSystem   @relation(fields: [relatedSystemId], references: [id])
  attachments      Attachment[]
  publicComments   PublicComment[]
  internalNotes    InternalNote[]

  // Indexes on fields used for filtering, sorting, and ownership queries
  @@index([requesterId])           // requester ownership
  @@index([ownerId])               // IT Staff ownership
  @@index([categoryId])            // category filter
  @@index([requestedPriority])     // requested priority filter
  @@index([itPriority])            // IT priority filter and sort
  @@index([status])                // status filter
  @@index([createdAt])             // default sort field
  @@index([updatedAt])             // secondary sort field
}

// Lab 3: Public Comment — visible to Requester, IT Staff, and Administrator.
model PublicComment {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  content   String   @db.Text
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId])
  @@index([createdAt])
}

// Lab 3: Internal Note — visible only to IT Staff and Administrator.
model InternalNote {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  content   String   @db.Text
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId])
  @@index([createdAt])
}

// Attachment — file metadata stored per Ticket.
// Soft removal: removedAt (nullable DateTime) is set on removal together with
// removalReason. A null removedAt means the attachment is active.
// Decision: nullable DateTime is used (not a boolean isRemoved) so that the
// exact removal timestamp is always recorded for audit purposes, with no extra
// column needed.
// storedPath is the server-generated storage path and is NEVER returned to clients.
model Attachment {
  id            Int       @id @default(autoincrement())
  ticketId      Int
  originalName  String                    // original filename from the user
  storedPath    String                    // server-generated unique storage path
  mimeType      String
  sizeBytes     Int
  uploadedAt    DateTime  @default(now())
  removedAt     DateTime?                 // null = active; set = soft-removed
  removalReason String?                   // required when removedAt is set

  ticket Ticket @relation(fields: [ticketId], references: [id])

  @@index([ticketId])               // attachment list per ticket
  @@index([removedAt])              // filter active vs removed attachments
}
